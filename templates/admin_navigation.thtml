<div class="mg-admin-nav">
    <div class="mg-admin-nav__primary">
        <a class="uk-button" href="{admin_home_url}">{lang_overview}</a>
        <form class="mg-admin-config-form" method="post" action="{configuration_url}">
            <input type="hidden" name="conf_group" value="mediagallery">
            <button type="submit" class="uk-button uk-button-primary">{lang_configuration}</button>
        </form>
        <a class="uk-button" href="{help_url}">{lang_help}</a>
    </div>

    <!-- BEGIN subnav -->
    <div class="mg-admin-subnav">
        <strong class="mg-admin-subnav__title">{subnav_title}</strong>
        <div class="mg-admin-subnav__links">
            <!-- BEGIN subnav_item -->
            <a href="{subnav_url}">{subnav_text}</a>
            <!-- END subnav_item -->
        </div>
    </div>
    <!-- END subnav -->
</div>
