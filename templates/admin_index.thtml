<div class="mg-admin-home">
    <div class="mg-admin-toolbar">
        <div class="mg-admin-toolbar__actions">
            <form class="mg-admin-config-form" method="post" action="{configuration_url}">
                <input type="hidden" name="conf_group" value="mediagallery">
                <button type="submit" class="uk-button uk-button-primary">{lang_configuration}</button>
            </form>
            <a class="uk-button" href="{help_url}">{lang_help}</a>
        </div>
    </div>

    {status_message}

    <p class="mg-admin-summary">{admin_help}</p>

    <div class="mg-admin-grid">
        <a class="mg-admin-card" href="{albums_url}">
            <span class="mg-admin-card__title">{lang_albums}</span>
            <span class="mg-admin-card__text">{lang_albums_help}</span>
        </a>

        <a class="mg-admin-card" href="{member_albums_url}">
            <span class="mg-admin-card__title">{lang_member_albums}</span>
            <span class="mg-admin-card__text">{lang_member_albums_help}</span>
        </a>

        <a class="mg-admin-card" href="{maintenance_url}">
            <span class="mg-admin-card__title">{lang_maintenance}</span>
            <span class="mg-admin-card__text">{lang_maintenance_help}</span>
        </a>

        <a class="mg-admin-card" href="{tools_url}">
            <span class="mg-admin-card__title">{lang_tools}</span>
            <span class="mg-admin-card__text">{lang_tools_help}</span>
        </a>

        <a class="mg-admin-card" href="{categories_url}">
            <span class="mg-admin-card__title">{lang_categories}</span>
            <span class="mg-admin-card__text">{lang_categories_help}</span>
        </a>
    </div>
</div>
