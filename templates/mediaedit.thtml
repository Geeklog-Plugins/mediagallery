<style type="text/css">
.mg-media-editor {
  max-width: 1180px;
  margin: 0 auto;
}

.mg-media-editor *,
.mg-media-editor *::before,
.mg-media-editor *::after {
  box-sizing: border-box;
}

.mg-media-editor .mg-media-preview-grid {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(220px, 1fr);
  gap: 18px;
  margin-bottom: 18px;
}

.mg-media-editor .mg-edit-card {
  min-width: 0;
  margin: 0 0 18px;
  padding: 18px;
  border: 1px solid rgba(127, 127, 127, .28);
  border-radius: 8px;
  background: rgba(127, 127, 127, .045);
}

.mg-media-editor fieldset.mg-edit-card {
  min-width: 0;
}

.mg-media-editor .mg-edit-card legend,
.mg-media-editor .mg-card-title {
  width: auto;
  margin: 0 0 12px;
  padding: 0 8px;
  font-size: 1.05em;
  font-weight: 700;
}

.mg-media-editor .mg-card-title {
  padding: 0;
}

.mg-media-editor .mg-preview-pane,
.mg-media-editor .mg-thumbnail-pane {
  text-align: center;
}

.mg-media-editor .mg-preview-content img,
.mg-media-editor .mg-thumbnail-content img {
  max-width: 100%;
  height: auto;
}

.mg-media-editor .mg-media-rotate-controls {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
}

.mg-media-editor .mg-media-rotate-controls .mg-float-left,
.mg-media-editor .mg-media-rotate-controls .mg-float-right {
  float: none;
}

.mg-media-editor .mg-edit-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  align-items: start;
}

.mg-media-editor .mg-edit-grid > .mg-edit-card {
  margin: 0;
}

.mg-media-editor .form_block {
  display: grid;
  grid-template-columns: minmax(170px, 34%) minmax(0, 1fr);
  column-gap: 18px;
  row-gap: 0;
  margin: 0;
}

.mg-media-editor .form_block dt,
.mg-media-editor .form_block dd {
  margin: 0;
  padding: 9px 0;
  border-bottom: 1px solid rgba(127, 127, 127, .14);
}

.mg-media-editor .form_block dt {
  font-weight: 600;
}

.mg-media-editor .form_block dt label {
  display: inline-block;
  padding-top: 5px;
}

.mg-media-editor .form_block dd {
  min-width: 0;
}

.mg-media-editor input[type="text"],
.mg-media-editor input[type="file"],
.mg-media-editor textarea,
.mg-media-editor select {
  max-width: 100%;
}

.mg-media-editor input[type="text"],
.mg-media-editor textarea {
  width: 100%;
}

.mg-media-editor textarea {
  min-height: 100px;
  resize: vertical;
}

.mg-media-editor .mg-inline-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.mg-media-editor .mg-file-control {
  display: grid;
  gap: 8px;
}

.mg-media-editor .mg-file-control label {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0;
}

.mg-media-editor .mg-media-meta {
  margin-bottom: 18px;
}

.mg-media-editor .mg_submit.mg-edit-actions {
  position: sticky;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0 0;
  padding: 14px 0;
  border-top: 1px solid rgba(127, 127, 127, .25);
  background: inherit;
}

.mg-media-editor .mg-edit-actions input[type="submit"],
.mg-media-editor .mg-edit-actions input[type="reset"] {
  min-width: 110px;
  padding: 8px 16px;
  border-radius: 5px;
  cursor: pointer;
}

.mg-media-editor .mg-edit-actions .mg-action-save {
  font-weight: 700;
}

.mg-media-editor .mg-edit-actions .mg-action-delete {
  margin-left: auto;
}

.mg-media-editor .mg-extra-options {
  margin-top: 18px;
}

.mg-media-editor .mg-extra-options > fieldset,
.mg-media-editor .mg-extra-options > div,
.mg-media-editor .mg-extra-options > table {
  max-width: 100%;
}

@media (max-width: 900px) {
  .mg-media-editor .mg-media-preview-grid,
  .mg-media-editor .mg-edit-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .mg-media-editor .mg-edit-card {
    padding: 14px;
  }

  .mg-media-editor .form_block {
    display: block;
  }

  .mg-media-editor .form_block dt {
    padding-bottom: 2px;
    border-bottom: 0;
  }

  .mg-media-editor .form_block dd {
    padding-top: 2px;
    padding-bottom: 12px;
  }

  .mg-media-editor .mg-media-rotate-controls {
    justify-content: center;
    flex-wrap: wrap;
  }

  .mg-media-editor .mg_submit.mg-edit-actions {
    position: static;
  }

  .mg-media-editor .mg-edit-actions input[type="submit"],
  .mg-media-editor .mg-edit-actions input[type="reset"] {
    flex: 1 1 auto;
  }

  .mg-media-editor .mg-edit-actions .mg-action-delete {
    margin-left: 0;
  }
}
</style>

<div class="mg-media-editor">
  <div class="mg-media-preview-grid">
    <section class="mg-edit-card mg-preview-pane">
      <h3 class="mg-card-title">{lang_media_item}</h3>
      <div class="mg-preview-content">
        {preview}
        <img src="{media_thumbnail}" alt=""{xhtml}>{preview_end}
      </div>
      <div class="mg-media-rotate-controls">
        <div class="mg-float-left">{s_rotate_left}</div>
        <div class="mg-float-right">{s_rotate_right}</div>
      </div>
    </section>

    <section class="mg-edit-card mg-thumbnail-pane">
      <h3 class="mg-card-title">{lang_attached_thumbnail}</h3>
      <div class="mg-thumbnail-content">{attached_thumbnail}</div>
    </section>
  </div>

  <form method="post" action="{site_url}/admin.php" class="compact uk-form mg-media-meta">
    <fieldset class="mg-edit-card">
      <legend>{lang_media_attributes}</legend>
      <dl class="form_block">
        <dt><label>{lang_comments}</label></dt>
        <dd>{media_comments}</dd>

        <dt><label>{views}</label></dt>
        <dd>
          <div class="mg-inline-actions">
            <span>{media_views}</span>
            <input type="submit" name="mode" value="{lang_reset_views}"{xhtml}>
          </div>
          <input type="hidden" name="action" value="resetviews"{xhtml}>
        </dd>

        <dt><label>{lang_rating}</label></dt>
        <dd>
          <div class="mg-inline-actions">
            <span>{media_rating}&nbsp;/&nbsp;{media_rating_max}&nbsp;({media_votes} {lang_votes})</span>
            <input type="submit" name="mode" value="{lang_reset_rating}"{xhtml}>
          </div>
          <input type="hidden" name="action" value="resetrating"{xhtml}>
        </dd>
      </dl>
    </fieldset>
    <input type="hidden" value="{album_id}" name="album_id"{xhtml}>
    <input type="hidden" value="{media_id}" name="mid"{xhtml}>
    <input type="hidden" value="{queue}" name="queue"{xhtml}>
    <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
  </form>

  <form name="media" enctype="multipart/form-data" method="post" action="{s_form_action}" class="MG_editform compact uk-form">
    <div class="mg-edit-grid">
      <fieldset class="mg-edit-card">
        <legend>{lang_mediaattributes}</legend>
        <dl class="form_block">
          <dt><label>{uploaded_by}</label></dt>
          <dd>{username}</dd>

          <dt><label for="original_filename">{lang_original_filename}</label></dt>
          <dd><input type="text" name="original_filename" id="original_filename" value="{original_filename}" class="size6"{xhtml}></dd>

          <dt><label for="media_title">{lang_title}</label></dt>
          <dd><input type="text" name="media_title" id="media_title" value="{media_title}" class="size6"{xhtml}></dd>

          <dt><label for="media_desc">{description}</label></dt>
          <dd><textarea name="media_desc" id="media_desc" cols="60" rows="4" class="size6">{media_desc}</textarea></dd>

          <dt><label for="media_keywords">{lang_keywords}</label></dt>
          <dd><input type="text" name="media_keywords" id="media_keywords" value="{media_keywords}" class="size6"{xhtml}></dd>

          <dt><label>{lang_category}</label></dt>
          <dd>{cat_select}</dd>

          <dt><label>{capture_time}</label></dt>
          <dd>{media_time}<br{xhtml}>{month_select} / {day_select} / {year_select}&nbsp;&nbsp;&nbsp;{hour_select}&nbsp;:&nbsp;{minute_select}</dd>
        </dl>
      </fieldset>

      <div>
        <fieldset class="mg-edit-card">
          <legend>{lang_attached_thumbnail}</legend>
          <dl class="form_block">
            <dt><label for="attachtn">{lang_attached_thumbnail}</label></dt>
            <dd>
              <div class="mg-file-control">
                <label for="attachtn"><input type="checkbox" name="attachtn" id="attachtn" value="1" {at_tn_checked}{xhtml}> {lang_attached_thumbnail}</label>
                <input type="file" name="attthumb" id="attthumb"{xhtml}>
              </div>
            </dd>

            <dt><label for="replacefile">{lang_replacefile}</label></dt>
            <dd>
              <div class="mg-file-control">
                <label for="replacefile"><input type="checkbox" name="replacefile" id="replacefile" value="1"{xhtml}> {lang_replacefile}</label>
                <input type="file" name="repfilename" id="repfilename"{xhtml}>
              </div>
            </dd>

            <dt><label for="remoteurl">{lang_remote_url}</label></dt>
            <dd><input type="text" name="remoteurl" id="remoteurl" value="{remoteurl}" class="size6"{xhtml}></dd>
          </dl>
        </fieldset>

        <fieldset class="mg-edit-card">
          <legend>{lang_artist}</legend>
          <dl class="form_block">
            <dt><label for="artist">{lang_artist}</label></dt>
            <dd><input type="text" name="artist" id="artist" value="{artist}" class="size6"{xhtml}></dd>

            <dt><label for="musicalbum">{lang_music_album}</label></dt>
            <dd><input type="text" name="musicalbum" id="musicalbum" value="{musicalbum}" class="size6"{xhtml}></dd>

            <dt><label for="genre">{lang_genre}</label></dt>
            <dd><input type="text" name="genre" id="genre" value="{genre}" class="size6"{xhtml}></dd>
          </dl>
        </fieldset>
      </div>
    </div>

    <div class="mg_submit mg-edit-actions">
      <input type="submit" name="mode" value="{lang_save}" class="mg-action-save"{xhtml}>
      <input type="submit" name="mode" value="{lang_cancel}"{xhtml}>
      <input type="reset" value="{lang_reset}"{xhtml}>
      <input type="submit" name="mode" value="{lang_delete}" class="mg-action-delete" data-confirm="{lang_delete_confirm}" onclick="return confirm(this.getAttribute('data-confirm'));"{xhtml}>
      <input type="hidden" name="rpath" value="{rpath}"{xhtml}>
      <input type="hidden" value="{album_id}" name="album_id"{xhtml}>
      <input type="hidden" value="{media_id}" name="mid"{xhtml}>
      <input type="hidden" value="{queue}" name="queue"{xhtml}>
      <input type="hidden" name="action" value="savemedia"{xhtml}>
      <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
    </div>

    <div class="mg-extra-options">
      {playback_options}
      {media_exif_info}
    </div>
  </form>
</div>
