<style type="text/css">
.mg-media-editor {
  max-width: 1180px;
  margin: 0 auto;
}

.mg-media-editor *,
.mg-media-editor *::before,
.mg-media-editor *::after {
  box-sizing: border-box;
}

.mg-media-editor .mg-edit-card {
  min-width: 0;
  margin: 0 0 18px;
  padding: 18px;
  border: 1px solid rgba(127, 127, 127, .28);
  border-radius: 8px;
  background: rgba(127, 127, 127, .045);
}

.mg-media-editor fieldset.mg-edit-card {
  min-width: 0;
}

.mg-media-editor .mg-edit-card legend,
.mg-media-editor .mg-card-title {
  width: auto;
  margin: 0 0 12px;
  padding: 0 8px;
  font-size: 1.05em;
  font-weight: 700;
}

.mg-media-editor .mg-card-title {
  padding: 0;
}

.mg-media-editor .mg-primary-card {
  padding: 22px;
}

.mg-media-editor .mg-primary-title {
  margin-bottom: 16px;
}

.mg-media-editor .mg-primary-title label,
.mg-media-editor .mg-primary-description label,
.mg-media-editor .mg-primary-meta-item label {
  display: block;
  margin-bottom: 7px;
  font-weight: 700;
}

.mg-media-editor .mg-primary-title input[type="text"] {
  width: 100%;
  padding: 10px 11px;
  font-size: 1.16em;
  font-weight: 600;
}

.mg-media-editor .mg-primary-description textarea {
  width: 100%;
  min-height: 120px;
}

.mg-media-editor .mg-primary-meta {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(240px, .8fr);
  gap: 18px;
  margin-top: 16px;
}

.mg-media-editor .mg-primary-meta-item input[type="text"],
.mg-media-editor .mg-primary-meta-item select {
  width: 100%;
  max-width: 100%;
}

.mg-media-editor .mg-workspace {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(330px, .8fr);
  gap: 18px;
  align-items: start;
}

.mg-media-editor .mg-preview-pane {
  text-align: center;
}

.mg-media-editor .mg-preview-content {
  display: flex;
  min-height: 220px;
  align-items: center;
  justify-content: center;
  padding: 12px;
  border-radius: 6px;
  background: rgba(127, 127, 127, .035);
}

.mg-media-editor .mg-preview-content img,
.mg-media-editor .mg-thumbnail-content img {
  max-width: 100%;
  height: auto;
}

.mg-media-editor .mg-media-rotate-controls {
  display: flex;
  justify-content: center;
  gap: 22px;
  margin-top: 12px;
}

.mg-media-editor .mg-media-rotate-controls .mg-float-left,
.mg-media-editor .mg-media-rotate-controls .mg-float-right {
  float: none;
}

.mg-media-editor .mg-media-rotate-controls img {
  width: 20px;
  height: 20px;
  object-fit: contain;
}

.mg-media-editor .mg-admin-details .form_block {
  grid-template-columns: minmax(135px, 37%) minmax(0, 1fr);
}

.mg-media-editor .mg-thumbnail-block {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid rgba(127, 127, 127, .14);
}

.mg-media-editor .mg-thumbnail-block strong {
  display: block;
  margin-bottom: 10px;
}

.mg-media-editor .mg-thumbnail-content {
  text-align: center;
}

.mg-media-editor .mg-secondary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  align-items: start;
  margin-top: 18px;
}

.mg-media-editor .mg-secondary-grid > .mg-edit-card {
  margin-bottom: 0;
}

.mg-media-editor .form_block {
  display: grid;
  grid-template-columns: minmax(155px, 34%) minmax(0, 1fr);
  column-gap: 18px;
  row-gap: 0;
  margin: 0;
}

.mg-media-editor .form_block dt,
.mg-media-editor .form_block dd {
  margin: 0;
  padding: 9px 0;
  border-bottom: 1px solid rgba(127, 127, 127, .14);
}

.mg-media-editor .form_block dt {
  font-weight: 600;
}

.mg-media-editor .form_block dt label {
  display: inline-block;
  padding-top: 5px;
}

.mg-media-editor .form_block dd {
  min-width: 0;
}

.mg-media-editor input[type="text"],
.mg-media-editor input[type="file"],
.mg-media-editor textarea,
.mg-media-editor select {
  max-width: 100%;
}

.mg-media-editor input[type="text"],
.mg-media-editor textarea {
  width: 100%;
}

.mg-media-editor textarea {
  resize: vertical;
}

.mg-media-editor .mg-file-control {
  display: grid;
  gap: 8px;
}

.mg-media-editor .mg-file-control label {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0;
}

.mg-media-editor .mg-capture-time {
  line-height: 1.8;
}

.mg-media-editor .mg-admin-metrics {
  margin-top: 18px;
}

.mg-media-editor .mg-metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.mg-media-editor .mg-metric {
  padding: 14px;
  border: 1px solid rgba(127, 127, 127, .16);
  border-radius: 6px;
  background: rgba(127, 127, 127, .025);
}

.mg-media-editor .mg-metric-label {
  display: block;
  margin-bottom: 6px;
  font-size: .92em;
  font-weight: 700;
  opacity: .8;
}

.mg-media-editor .mg-metric-value {
  display: block;
  margin-bottom: 10px;
  font-size: 1.08em;
  font-weight: 600;
}

.mg-media-editor .mg-metric input[type="submit"] {
  width: 100%;
}

.mg-media-editor .mg_submit.mg-edit-actions {
  position: sticky;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0 0;
  padding: 14px 0;
  border-top: 1px solid rgba(127, 127, 127, .25);
  background: inherit;
}

.mg-media-editor .mg-edit-actions input[type="submit"],
.mg-media-editor .mg-edit-actions input[type="reset"] {
  min-width: 110px;
  padding: 8px 16px;
  border-radius: 5px;
  cursor: pointer;
}

.mg-media-editor .mg-edit-actions .mg-action-save {
  min-width: 130px;
  font-weight: 700;
}

.mg-media-editor .mg-edit-actions .mg-action-delete {
  margin-left: auto;
}

.mg-media-editor .mg-extra-options {
  margin-top: 18px;
}

.mg-media-editor .mg-extra-options > fieldset,
.mg-media-editor .mg-extra-options > div,
.mg-media-editor .mg-extra-options > table {
  max-width: 100%;
}

@media (max-width: 900px) {
  .mg-media-editor .mg-workspace,
  .mg-media-editor .mg-secondary-grid,
  .mg-media-editor .mg-primary-meta,
  .mg-media-editor .mg-metrics-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .mg-media-editor .mg-edit-card,
  .mg-media-editor .mg-primary-card {
    padding: 14px;
  }

  .mg-media-editor .form_block {
    display: block;
  }

  .mg-media-editor .form_block dt {
    padding-bottom: 2px;
    border-bottom: 0;
  }

  .mg-media-editor .form_block dd {
    padding-top: 2px;
    padding-bottom: 12px;
  }

  .mg-media-editor .mg_submit.mg-edit-actions {
    position: static;
  }

  .mg-media-editor .mg-edit-actions input[type="submit"],
  .mg-media-editor .mg-edit-actions input[type="reset"] {
    flex: 1 1 auto;
  }

  .mg-media-editor .mg-edit-actions .mg-action-delete {
    margin-left: 0;
  }
}
</style>

<div class="mg-media-editor">
  <form name="media" enctype="multipart/form-data" method="post" action="{s_form_action}" class="MG_editform compact uk-form">
    <section class="mg-edit-card mg-primary-card">
      <div class="mg-primary-title">
        <label for="media_title">{lang_title}</label>
        <input type="text" name="media_title" id="media_title" value="{media_title}" class="size6"{xhtml}>
      </div>

      <div class="mg-primary-description">
        <label for="media_desc">{description}</label>
        <textarea name="media_desc" id="media_desc" cols="60" rows="4" class="size6">{media_desc}</textarea>
      </div>

      <div class="mg-primary-meta">
        <div class="mg-primary-meta-item">
          <label for="media_keywords">{lang_keywords}</label>
          <input type="text" name="media_keywords" id="media_keywords" value="{media_keywords}" class="size6"{xhtml}>
        </div>
        <div class="mg-primary-meta-item">
          <label>{lang_category}</label>
          {cat_select}
        </div>
      </div>
    </section>

    <div class="mg-workspace">
      <section class="mg-edit-card mg-preview-pane">
        <h3 class="mg-card-title">{lang_media_item}</h3>
        <div class="mg-preview-content">
          {preview}
          <img src="{media_thumbnail}" alt=""{xhtml}>{preview_end}
        </div>
        <div class="mg-media-rotate-controls">
          <div>{s_rotate_left}</div>
          <div>{s_rotate_right}</div>
        </div>
      </section>

      <fieldset class="mg-edit-card mg-admin-details">
        <legend>{lang_mediaattributes}</legend>
        <dl class="form_block">
          <dt><label>{uploaded_by}</label></dt>
          <dd>{username}</dd>

          <dt><label for="original_filename">{lang_original_filename}</label></dt>
          <dd><input type="text" name="original_filename" id="original_filename" value="{original_filename}" class="size6"{xhtml}></dd>

          <dt><label>{capture_time}</label></dt>
          <dd class="mg-capture-time">{media_time}<br{xhtml}>{month_select} / {day_select} / {year_select}<br{xhtml}>{hour_select}&nbsp;:&nbsp;{minute_select}</dd>
        </dl>

{!if attached_thumbnail}
        <div class="mg-thumbnail-block">
          <strong>{lang_attached_thumbnail}</strong>
          <div class="mg-thumbnail-content">{attached_thumbnail}</div>
        </div>
{!endif}
      </fieldset>
    </div>

    <div class="mg-secondary-grid">
      <fieldset class="mg-edit-card">
        <legend>{lang_attached_thumbnail}</legend>
        <dl class="form_block">
          <dt><label for="attachtn">{lang_attached_thumbnail}</label></dt>
          <dd>
            <div class="mg-file-control">
              <label for="attachtn"><input type="checkbox" name="attachtn" id="attachtn" value="1" {at_tn_checked}{xhtml}> {lang_attached_thumbnail}</label>
              <input type="file" name="attthumb" id="attthumb"{xhtml}>
            </div>
          </dd>

          <dt><label for="replacefile">{lang_replacefile}</label></dt>
          <dd>
            <div class="mg-file-control">
              <label for="replacefile"><input type="checkbox" name="replacefile" id="replacefile" value="1"{xhtml}> {lang_replacefile}</label>
              <input type="file" name="repfilename" id="repfilename"{xhtml}>
            </div>
          </dd>

          <dt><label for="remoteurl">{lang_remote_url}</label></dt>
          <dd><input type="text" name="remoteurl" id="remoteurl" value="{remoteurl}" class="size6"{xhtml}></dd>
        </dl>
      </fieldset>

      <fieldset class="mg-edit-card">
        <legend>{lang_artist}</legend>
        <dl class="form_block">
          <dt><label for="artist">{lang_artist}</label></dt>
          <dd><input type="text" name="artist" id="artist" value="{artist}" class="size6"{xhtml}></dd>

          <dt><label for="musicalbum">{lang_music_album}</label></dt>
          <dd><input type="text" name="musicalbum" id="musicalbum" value="{musicalbum}" class="size6"{xhtml}></dd>

          <dt><label for="genre">{lang_genre}</label></dt>
          <dd><input type="text" name="genre" id="genre" value="{genre}" class="size6"{xhtml}></dd>
        </dl>
      </fieldset>
    </div>

    <div class="mg_submit mg-edit-actions">
      <input type="submit" name="mode" value="{lang_save}" class="mg-action-save"{xhtml}>
      <input type="submit" name="mode" value="{lang_cancel}"{xhtml}>
      <input type="reset" value="{lang_reset}"{xhtml}>
      <input type="submit" name="mode" value="{lang_delete}" class="mg-action-delete" data-confirm="{lang_delete_confirm}" onclick="return confirm(this.getAttribute('data-confirm'));"{xhtml}>
      <input type="hidden" name="rpath" value="{rpath}"{xhtml}>
      <input type="hidden" value="{album_id}" name="album_id"{xhtml}>
      <input type="hidden" value="{media_id}" name="mid"{xhtml}>
      <input type="hidden" value="{queue}" name="queue"{xhtml}>
      <input type="hidden" name="action" value="savemedia"{xhtml}>
      <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
    </div>

    <div class="mg-extra-options">
      {playback_options}
      {media_exif_info}
    </div>
  </form>

  <form method="post" action="{site_url}/admin.php" class="compact uk-form mg-admin-metrics">
    <fieldset class="mg-edit-card">
      <legend>{lang_media_attributes}</legend>
      <div class="mg-metrics-grid">
        <div class="mg-metric">
          <span class="mg-metric-label">{lang_comments}</span>
          <span class="mg-metric-value">{media_comments}</span>
        </div>

        <div class="mg-metric">
          <span class="mg-metric-label">{views}</span>
          <span class="mg-metric-value">{media_views}</span>
          <input type="submit" name="mode" value="{lang_reset_views}"{xhtml}>
        </div>

        <div class="mg-metric">
          <span class="mg-metric-label">{lang_rating}</span>
          <span class="mg-metric-value">{media_rating}&nbsp;/&nbsp;{media_rating_max}&nbsp;({media_votes} {lang_votes})</span>
          <input type="submit" name="mode" value="{lang_reset_rating}"{xhtml}>
        </div>
      </div>
    </fieldset>
    <input type="hidden" name="action" value="resetviews"{xhtml}>
    <input type="hidden" value="{album_id}" name="album_id"{xhtml}>
    <input type="hidden" value="{media_id}" name="mid"{xhtml}>
    <input type="hidden" value="{queue}" name="queue"{xhtml}>
    <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
  </form>
</div>
