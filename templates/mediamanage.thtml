<div class="mg-manager">
  <header class="mg-manager-header">
    <div>
      <h2>{lang_media_manage_title}</h2>
      <p>{lang_media_manage_help}</p>
    </div>
    <div class="mg-manager-header__actions">
      <a class="uk-button uk-button-small mg-button-quiet" href="{url_album}">{lang_return_album}</a>
      <a class="uk-button uk-button-primary" href="{upload_url}">{lang_upload_media}</a>
    </div>
  </header>

  <form id="MG_mediamanage" name="media" method="post" action="{s_form_action}" class="uk-form">
    {!if lang_no_image}<div class="noitems">{lang_no_image}</div>{!endif}

    {mediaitems}

    <div class="mg-manager-pagination">{bottom_pagination}</div>

    <div class="mg-manager-savebar">
      <input type="hidden" name="album_id" value="{album_id}"{xhtml}>
      <input type="hidden" name="action" value="media"{xhtml}>
      <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
      <input type="submit" name="mode" value="{lang_save}" class="uk-button uk-button-primary"{xhtml}>
      <input type="submit" name="mode" value="{lang_cancel}" class="uk-button mg-button-quiet"{xhtml}>
      <input type="submit" name="mode" value="{lang_delete}" class="uk-button mg-button-danger" data-confirm="{lang_delete_confirm}" onclick="return confirm(this.getAttribute('data-confirm'));"{xhtml}>
    </div>
  </form>
</div>
