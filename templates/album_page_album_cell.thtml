<article class="mg_album_item mg-card mg-card-square">
  <div class="mg-card-media">
    <div class="mg_thumbnail">
      <div class="mg_thumbnail_wrapper"><a class="mg-card-image-link" href="{u_viewalbum}"><span class="mg-card-preview-stack"><img class="mg-card-preview-image mg-card-preview-cover" src="{album_last_image}" alt="{album_title}" loading="lazy" decoding="async"><img class="mg-card-preview-image mg-card-preview-full" src="{album_last_image}" alt="" aria-hidden="true" loading="lazy" decoding="async"></span></a></div>
    </div>
  </div>

  <div class="mg-card-body">
    <h2 class="mg_album_item_title mg-card-title"><a href="{u_viewalbum}">{album_title}</a> <span class="mg_item_count" aria-label="Media count">{subalbum_media_count}</span></h2>

    {!if album_desc}<div class="mg-card-description">{album_desc}</div>{!endif}

    <div class="mg-card-meta mg-card-meta-album">
      {!if lang_views}<span class="mg-card-album-views"><span class="mg-visually-hidden">{lang_views}: </span>{views}</span>{!endif}
      {!if lang_subalbums}<span><strong>{lang_subalbums}</strong> {subalbumcount}</span>{!endif}
    </div>
  </div>
</article>
