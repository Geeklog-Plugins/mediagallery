<form action="{s_form_action}" method="post" class="compact uk-form">
  <div class="admin_basic mg-envcheck" id="admin-editor">
<!-- BEGIN CheckRow1 -->
    <section class="mg-envcheck-section">
      <h3 class="mg-envcheck-title">{config_title}</h3>
      <dl class="form_block mg-envcheck-list">
<!-- BEGIN CheckRow2 -->
        <dt>{config_item}</dt>
        <dd>{status}</dd>
<!-- END CheckRow2 -->
      </dl>
    </section>
<!-- END CheckRow1 -->
    <div class="mg_submit mg-envcheck-actions">
      {!if storage_migration_needed}
      <p class="mg-envcheck-help">{repair_storage_help}</p>
      <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
      <div class="mg-envcheck-buttons">
        <button class="uk-button uk-button-primary" type="submit" name="action" value="repair_media_storage">{lang_repair_storage}</button>
      {!else}
      <p class="mg-envcheck-current">{media_storage_current}</p>
      <div class="mg-envcheck-buttons">
      {!endif}
        <input class="uk-button uk-button-default" type="submit" name="mode" value="{lang_recheck}"{xhtml}>
        <input class="uk-button uk-button-default" type="submit" name="mode" value="{lang_continue}"{xhtml}>
      </div>
    </div>
  </div>
</form>
