{start_block}
<style type="text/css">
.MG_editform.mg-album-editor {
  max-width: 1180px;
  margin: 0 auto;
}

.mg-album-editor *,
.mg-album-editor *::before,
.mg-album-editor *::after {
  box-sizing: border-box;
}

.mg-album-editor .mg-edit-card {
  margin: 0 0 18px;
  padding: 18px;
  border: 1px solid rgba(127, 127, 127, .28);
  border-radius: 8px;
  background: rgba(127, 127, 127, .045);
}

.mg-album-editor fieldset.mg-edit-card {
  min-width: 0;
}

.mg-album-editor .mg-edit-card legend {
  width: auto;
  margin: 0 0 6px;
  padding: 0 8px;
  font-size: 1.05em;
  font-weight: 700;
}

.mg-album-editor .mg-edit-intro {
  padding-top: 20px;
}

.mg-album-editor .mg-edit-grid {
  display: block;
  columns: 2;
  column-gap: 18px;
}

.mg-album-editor .mg-edit-grid > * {
  display: inline-block;
  width: 100%;
  margin: 0 0 18px;
  vertical-align: top;
  break-inside: avoid;
}

.mg-album-editor .mg-edit-grid > .mg-edit-card {
  margin: 0 0 18px;
}

.mg-album-editor .mg-edit-grid .mg-edit-card:last-child {
  margin-bottom: 0;
}

.mg-album-editor .mg-access-rights {
  column-span: all;
  display: block;
  width: 100%;
  margin-top: 18px;
}

.mg-album-editor .form_block {
  display: grid;
  grid-template-columns: minmax(170px, 34%) minmax(0, 1fr);
  column-gap: 18px;
  row-gap: 0;
  margin: 0;
}

.mg-album-editor .form_block dt,
.mg-album-editor .form_block dd {
  margin: 0;
  padding: 8px 0;
  border-bottom: 1px solid rgba(127, 127, 127, .14);
}

.mg-album-editor .form_block dt {
  font-weight: 600;
}

.mg-album-editor .form_block dt label {
  display: inline-block;
  padding-top: 5px;
}

.mg-album-editor .form_block dd {
  min-width: 0;
}

.mg-album-editor .form_block dd.description {
  grid-column: 2;
  margin-top: -4px;
  padding-top: 0;
  color: inherit;
  opacity: .75;
  font-size: .92em;
}

.mg-album-editor .form_block > :nth-last-child(-n+2) {
  border-bottom-color: transparent;
}

.mg-album-editor input[type="text"],
.mg-album-editor input[type="file"],
.mg-album-editor textarea,
.mg-album-editor select {
  max-width: 100%;
}

.mg-album-editor input[type="text"],
.mg-album-editor textarea {
  width: 100%;
}

.mg-album-editor textarea {
  min-height: 92px;
  resize: vertical;
}

.mg-album-editor .mg-cover-preview img,
.mg-album-editor .form_block dd img {
  max-width: 100%;
  height: auto;
}

.mg-album-editor .mg-format-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.mg-album-editor .mg-format-group {
  padding: 14px;
  border: 1px solid rgba(127, 127, 127, .2);
  border-radius: 6px;
  background: rgba(127, 127, 127, .04);
}

.mg-album-editor .mg-format-group h4 {
  margin: 0 0 12px;
  font-size: 1em;
  font-weight: 700;
}

.mg-album-editor .mg-format-options {
  display: grid;
  gap: 8px;
}

.mg-album-editor .mg-format-options label {
  display: flex;
  gap: 8px;
  align-items: center;
  margin: 0;
  cursor: pointer;
}

.mg-album-editor .mg-format-options input[type="checkbox"] {
  flex: 0 0 auto;
  margin: 0;
}

.mg-album-editor .mg_submit.mg-edit-actions {
  position: sticky;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0 0;
  padding: 14px 0;
  border-top: 1px solid rgba(127, 127, 127, .25);
  background: inherit;
}

.mg-album-editor .mg-edit-actions .submit {
  min-width: 110px;
  padding: 8px 16px;
  border-radius: 5px;
  cursor: pointer;
}

.mg-album-editor .mg-edit-actions .mg-action-save {
  font-weight: 700;
}

.mg-album-editor .mg-edit-actions .mg-action-delete {
  margin-left: auto;
}

@media (max-width: 900px) {
  .mg-album-editor .mg-edit-grid {
    columns: 1;
  }

  .mg-album-editor .mg-format-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .mg-album-editor .mg-edit-card {
    padding: 14px;
  }

  .mg-album-editor .form_block {
    display: block;
  }

  .mg-album-editor .form_block dt {
    padding-bottom: 2px;
    border-bottom: 0;
  }

  .mg-album-editor .form_block dd {
    padding-top: 2px;
    padding-bottom: 12px;
  }

  .mg-album-editor .form_block dd.description {
    margin-top: -8px;
  }

  .mg-album-editor .mg-format-grid {
    grid-template-columns: 1fr;
  }

  .mg-album-editor .mg_submit.mg-edit-actions {
    position: static;
  }

  .mg-album-editor .mg-edit-actions .submit {
    flex: 1 1 auto;
  }

  .mg-album-editor .mg-edit-actions .mg-action-delete {
    margin-left: 0;
  }
}
</style>

<script type="text/javascript">
<!--
function change(what) {
    value = '{path_mg}/watermarks/' + what.options[what.selectedIndex].value;
    if (value != '')
        if (document.images)
            document.images['myImage'].src = value;
}
//-->
</script>

<form enctype="multipart/form-data" method="post" action="{s_form_action}" class="MG_editform compact uk-form mg-album-editor">
  <div class="admin_basic">
    <div class="mg-edit-card mg-edit-intro">
      <dl class="form_block">
        <dt><label for="mg-album-name">{lang_title}</label></dt>
        <dd><input type="text" id="mg-album-name" name="album_name" value="{album_title}" class="size6"{xhtml}></dd>

        <dt><label for="mg-album-desc">{lang_description}</label></dt>
        <dd><textarea id="mg-album-desc" name="album_desc" cols="50" rows="3" class="wide">{album_desc}</textarea></dd>

        <dt><label>{lang_parent_album}</label></dt>
        <dd>{parent_select}</dd>
      </dl>
    </div>

    <div class="mg-edit-grid">
      <fieldset class="mg-edit-card">
        <legend>{lang_album_attributes}</legend>
        <dl class="form_block">
          <dt><label>{lang_theme_select}</label></dt>
          <dd>{album_theme_select}</dd>

          <dt><label>{lang_comments}</label></dt>
          <dd>{comment_select}</dd>

          <dt><label>{lang_enable_exif}</label></dt>
          <dd>{exif_select}</dd>

          <dt><label>{lang_enable_ratings}</label></dt>
          <dd>{ranking_select}</dd>

          <dt><label>{lang_enable_rss}</label></dt>
          <dd>{rss_select}</dd>

          <dt><label>{lang_rsschildren}</label></dt>
          <dd>{rsschildren_select}</dd>

          <dt><label>{lang_podcast}</label></dt>
          <dd>{podcast_select}</dd>

          <dt><label>{lang_mp3ribbon}</label></dt>
          <dd>{mp3ribbon_select}</dd>

          <dt><label>{lang_enable_sort}</label></dt>
          <dd>{sort_select}</dd>

          <dt><label>{lang_album_sort}</label></dt>
          <dd>{album_sort_select}</dd>

          <dt><label>{lang_display_album_desc}</label></dt>
          <dd>{display_album_desc_select}</dd>

          <dt><label>{lang_enable_album_views}</label></dt>
          <dd>{album_views_select}</dd>

          <dt><label>{lang_enable_views}</label></dt>
          <dd>{views_select}</dd>

          <dt><label>{lang_enable_keywords}</label></dt>
          <dd>{keywords_select}</dd>

          <dt><label>{lang_image_skin}</label></dt>
          <dd>{skin_select}</dd>

          <dt><label>{lang_display_skin}</label></dt>
          <dd>{dskin_select}</dd>

          <dt><label>{lang_album_skin}</label></dt>
          <dd>{askin_select}</dd>

          <dt><label>{lang_albums_first}</label></dt>
          <dd>{afirst_select}</dd>

          <dt><label>{lang_tn_size}</label></dt>
          <dd>{tn_size_select}</dd>

          <dt><label>{lang_tnwidth}</label></dt>
          <dd>{tnwidth_input}</dd>

          <dt><label>{lang_tnheight}</label></dt>
          <dd>{tnheight_input}</dd>

          <dt><label>{lang_av_play_options}</label></dt>
          <dd>{playback_type}</dd>

          <dt><label>{lang_ss_enable}</label></dt>
          <dd>{ss_select}</dd>

          <dt><label>{lang_rows}</label></dt>
          <dd>{rows_input}</dd>

          <dt><label>{lang_columns}</label></dt>
          <dd>{columns_input}</dd>
        </dl>
      </fieldset>

      <div>
        <fieldset class="mg-edit-card">
          <legend>{lang_album_cover}</legend>
          <dl class="form_block">
{!if thumbnail}
            <dt><label>{lang_thumbnail}</label></dt>
            <dd class="mg-cover-preview">{thumbnail}</dd>
{!endif}
            <dt><label>{lang_attached_thumbnail}</label></dt>
            <dd>{attach_select}</dd>

            <dt><label for="mg-album-thumbnail-upload">{lang_thumbnail}</label></dt>
            <dd><input type="file" id="mg-album-thumbnail-upload" dir="ltr" name="thumbnail"{xhtml}></dd>
          </dl>
        </fieldset>

        <fieldset class="mg-edit-card">
          <legend>{lang_featured_album}</legend>
          <dl class="form_block">
            <dt><label>{lang_set_featured}</label></dt>
            <dd>{featured_select}</dd>
            <dd class="description">{lang_featured_help}</dd>

            <dt><label>{lang_position}</label></dt>
            <dd>{feature_position}</dd>

            <dt><label>{lang_topic}</label></dt>
            <dd>{feature_page_select}</dd>
          </dl>
        </fieldset>
      </div>
    </div>

    <div class="mg-edit-grid" style="margin-top:18px;">
      <fieldset class="mg-edit-card">
        <legend>{lang_media_attributes}</legend>
        <dl class="form_block">
          <dt><label>{lang_filename_title}</label></dt>
          <dd>{filename_title_select}</dd>

          <dt><label>{lang_allow_download}</label></dt>
          <dd>{allow_download_select}</dd>

          <dt><label>{lang_full_display}</label></dt>
          <dd>{full_select}</dd>

          <dt><label>{lang_ri_enable}</label></dt>
          <dd>{ri_select}</dd>

          <dt><label>{lang_max_image_width}</label></dt>
          <dd>{width_input}</dd>

          <dt><label>{lang_max_image_height}</label></dt>
          <dd>{height_input}</dd>

          <dt><label>{lang_max_filesize}</label></dt>
          <dd>{max_size_input}&nbsp;Kb {lang_unlimited}</dd>

          <dt><label>{lang_display_image_size}</label></dt>
          <dd>{display_image_size}</dd>

          <dt><label>{lang_usealternate}</label></dt>
          <dd>{usealternate_select}</dd>
        </dl>
      </fieldset>

      <fieldset class="mg-edit-card">
        <legend>{lang_watermark}</legend>
        <dl class="form_block">
          <dt><label>{lang_wm_auto}</label></dt>
          <dd>{wm_auto_select}</dd>

          <dt><label>{lang_wm_opacity}</label></dt>
          <dd>{wm_opacity_select}</dd>

          <dt><label>{lang_wm_location}</label></dt>
          <dd>{wm_location_select}</dd>

          <dt><label>{lang_wm_id}</label></dt>
          <dd>{wm_select}</dd>
          <dd class="description">{wm_current}</dd>
        </dl>
      </fieldset>
    </div>

    <fieldset class="mg-edit-card" style="margin-top:18px;">
      <legend>{lang_allowed_formats}</legend>
      <div class="mg-format-grid">
        <div class="mg-format-group">
          <h4>{lang_image}</h4>
          <div class="mg-format-options">
            <label for="mg-format-jpg"><input type="checkbox" id="mg-format-jpg" name="format_jpg" value="1" {jpg_checked}{xhtml}> {lang_jpg}</label>
            <label for="mg-format-png"><input type="checkbox" id="mg-format-png" name="format_png" value="2" {png_checked}{xhtml}> {lang_png}</label>
            <label for="mg-format-tif"><input type="checkbox" id="mg-format-tif" name="format_tif" value="4" {tif_checked}{xhtml}> {lang_tif}</label>
            <label for="mg-format-gif"><input type="checkbox" id="mg-format-gif" name="format_gif" value="8" {gif_checked}{xhtml}> {lang_gif}</label>
            <label for="mg-format-bmp"><input type="checkbox" id="mg-format-bmp" name="format_bmp" value="16" {bmp_checked}{xhtml}> {lang_bmp}</label>
            <label for="mg-format-tga"><input type="checkbox" id="mg-format-tga" name="format_tga" value="32" {tga_checked}{xhtml}> {lang_tga}</label>
            <label for="mg-format-psd"><input type="checkbox" id="mg-format-psd" name="format_psd" value="64" {psd_checked}{xhtml}> {lang_psd}</label>
          </div>
        </div>

        <div class="mg-format-group">
          <h4>{lang_audio} / {lang_video}</h4>
          <div class="mg-format-options">
            <label for="mg-format-mp3"><input type="checkbox" id="mg-format-mp3" name="format_mp3" value="128" {mp3_checked}{xhtml}> {lang_mp3}</label>
            <label for="mg-format-ogg"><input type="checkbox" id="mg-format-ogg" name="format_ogg" value="256" {ogg_checked}{xhtml}> {lang_ogg}</label>
            <label for="mg-format-asf"><input type="checkbox" id="mg-format-asf" name="format_asf" value="512" {asf_checked}{xhtml}> {lang_asf}</label>
            <label for="mg-format-swf"><input type="checkbox" id="mg-format-swf" name="format_swf" value="1024" {swf_checked}{xhtml}> {lang_swf}</label>
            <label for="mg-format-mov"><input type="checkbox" id="mg-format-mov" name="format_mov" value="2048" {mov_checked}{xhtml}> {lang_mov}</label>
            <label for="mg-format-mp4"><input type="checkbox" id="mg-format-mp4" name="format_mp4" value="4096" {mp4_checked}{xhtml}> {lang_mp4}</label>
            <label for="mg-format-mpg"><input type="checkbox" id="mg-format-mpg" name="format_mpg" value="8192" {mpg_checked}{xhtml}> {lang_mpg}</label>
            <label for="mg-format-flv"><input type="checkbox" id="mg-format-flv" name="format_flv" value="131072" {flv_checked}{xhtml}> {lang_flv}</label>
            <label for="mg-format-rflv"><input type="checkbox" id="mg-format-rflv" name="format_rflv" value="262144" {rflv_checked}{xhtml}> {lang_rflv}</label>
            <label for="mg-format-emb"><input type="checkbox" id="mg-format-emb" name="format_emb" value="524288" {emb_checked}{xhtml}> {lang_emb}</label>
          </div>
        </div>

        <div class="mg-format-group">
          <h4>{lang_other}</h4>
          <div class="mg-format-options">
            <label for="mg-format-zip"><input type="checkbox" id="mg-format-zip" name="format_zip" value="16384" {zip_checked}{xhtml}> {lang_zip}</label>
            <label for="mg-format-other"><input type="checkbox" id="mg-format-other" name="format_other" value="32768" {other_checked}{xhtml}> {lang_other}</label>
          </div>
        </div>
      </div>
    </fieldset>

{!if perms_editor_admin}
    <div class="mg-edit-grid">
      <fieldset class="mg-edit-card">
        <legend>{lang_uploads}</legend>
        <dl class="form_block">
          <dt><label>{lang_member_upload}</label></dt>
          <dd>{uploads}</dd>

          <dt><label>{lang_moderate_album}</label></dt>
          <dd>{moderate}</dd>

          <dt><label>{lang_mod_group}</label></dt>
          <dd>{mod_dropdown}</dd>

          <dt><label>{lang_email_mods_on_submission}</label></dt>
          <dd>{email_mod_select}</dd>
        </dl>
      </fieldset>

      <fieldset class="mg-edit-card mg-access-rights">
        <legend>{lang_accessrights}</legend>
        <dl class="form_block">
          <dt><label>{lang_owner}</label></dt>
          <dd>{owner_select}</dd>

          <dt><label>{lang_group}</label></dt>
          <dd>{group_dropdown}</dd>

          <dt><label>{lang_permissions}</label></dt>
          <dd>{permissions_editor}</dd>
          <dd class="description">{lang_perm_key}</dd>

          <dt><label>{lang_hidden}</label></dt>
          <dd>{hidden}</dd>

          <dt><label>{lang_force_child_update}</label></dt>
          <dd>{force_child_update}</dd>
        </dl>
      </fieldset>
    </div>
{!endif}

{!if perms_editor_member}
    <fieldset class="mg-edit-card mg-access-rights">
      <legend>{lang_accessrights}</legend>
      <dl class="form_block">
        <dt><label>{lang_owner}</label></dt>
        <dd>{owner_username}<input type="hidden" name="owner_id" value="{owner_id}"{xhtml}></dd>

        <dt><label>{lang_permissions}</label></dt>
        <dd>{permissions_editor}</dd>
        <dd class="description">{lang_perm_key}</dd>

        <dt><label>{lang_force_child_update}</label></dt>
        <dd>{force_child_update}</dd>
      </dl>
    </fieldset>
{!endif}

    <div class="mg_submit mg-edit-actions">
      <input type="submit" value="{lang_save}" name="mode" class="submit mg-action-save"{xhtml}>
      <input type="submit" value="{lang_cancel}" name="mode" class="submit mg-action-cancel"{xhtml}>
      <input type="submit" value="{lang_delete}" name="mode" class="submit mg-action-delete"{xhtml}>
      <input type="hidden" name="album_id" value="{album_id}"{xhtml}>
      <input type="hidden" name="cover" value="{album_cover}"{xhtml}>
      <input type="hidden" name="owner" value="{album_owner}"{xhtml}>
      <input type="hidden" name="order" value="{album_order}"{xhtml}>
      <input type="hidden" name="album_cover_filename" value="{album_cover_filename}"{xhtml}>
      <input type="hidden" name="last_update" value="{last_update}"{xhtml}>
      <input type="hidden" name="media_count" value="{media_count}"{xhtml}>
      <input type="hidden" name="action" value="{action}"{xhtml}>
      <input type="hidden" name="origaid" value="{old_album_id}"{xhtml}>
    </div>
  </div>
</form>
{end_block}
