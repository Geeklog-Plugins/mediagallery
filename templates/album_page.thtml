{lbslideshow}
<script type="text/javascript" src="{site_url}/players/audio-player.js"></script>

<nav class="bc_navigation" aria-label="Breadcrumb">
{birdseed}
</nav>

<header class="mg_album_header mg-album-page-header">
  <div class="mg-album-heading">
    <h1 class="mg_album_title">{album_title}{!if rsslink}&nbsp;&nbsp;{rsslink}{!endif}</h1>
    <nav class="mg-album-inline-actions" aria-label="Album actions">
      {!if url_slideshow}
      <a href="{url_slideshow}"{slideshow_onclick}>{lang_slideshow}</a>
      {!endif}
      {!if edit_album}
      <a class="mg-album-admin-action" href="{url_edit}">{lang_edit}</a>
      {!endif}
    </nav>
  </div>
  <div class="mg-album-controls">
    <details class="mg-compact-search">
      <summary>{lang_search}</summary>
      <div class="mg_search">
        <form name="mgsearch" method="post" action="{site_url}/search.php" class="uk-form" role="search">
          <div>
            <label for="mg-search-keywords" class="mg-visually-hidden">{lang_search}</label>
            <input id="mg-search-keywords" type="search" name="keywords" value="{keywords}" aria-label="{lang_search}"{xhtml}>
            <input type="hidden" name="mode" value="search"{xhtml}>
            <input type="hidden" name="swhere" value="0"{xhtml}>
            <input type="submit" value="{lang_search}"{xhtml}>
          </div>
        </form>
      </div>
    </details>
    {!if select_adminbox}
    <div class="mg_adminbox mg-secondary-control">
      {select_adminbox}
    </div>
    {!endif}
  </div>
</header>

{!if top_pagination}
<nav class="mg-album-top-pagination" aria-label="Album pagination">
  <div class="mg_pagination">{top_pagination}</div>
</nav>
{!endif}

{!if album_description}
<section class="mg_album_description">
   {album_description}
</section>
{!endif}

{!if album_body}
<div class="mg_album_grid mg-album-default-grid {grid_class}" role="list">
<!-- BEGIN ImageRow -->
<!-- BEGIN ImageColumn -->
<div class="mg_album_cell" role="listitem">
{CELL_DISPLAY_IMAGE}
</div>
<!-- END ImageColumn -->
<!-- END ImageRow -->
</div>
{!endif}

{!if lang_no_image}<div class="noitems">{lang_no_image}</div>{!endif}

<footer class="mg-album-footer mg-album-footer-compact">
  <nav class="mg-album-pagination-bar" aria-label="Album pagination and information">
    <div class="mg-album-page-info">
      <span>{page_number}</span>
    </div>
    <div class="mg_pagination">{bottom_pagination}</div>
  </nav>
  <div class="mg-album-secondary-controls">
    <div class="mg_jumpbox mg-secondary-control">{jumpbox}</div>
    <div class="mg_sortbox mg-secondary-control">{select_sortbox}</div>
  </div>
</footer>
