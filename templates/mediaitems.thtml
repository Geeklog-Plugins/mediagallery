<script type="text/javascript">
function doCheckAll_mediaitems() {
  var form = document.media;
  if (!form) return;
  for (var i = 0; i < form.elements.length; i++) {
    if (form.elements[i].type === 'checkbox' && form.elements[i].name === 'sel[]') {
      form.elements[i].checked = true;
    }
  }
}
function doUnCheckAll_mediaitems() {
  var form = document.media;
  if (!form) return;
  for (var i = 0; i < form.elements.length; i++) {
    if (form.elements[i].type === 'checkbox' && form.elements[i].name === 'sel[]') {
      form.elements[i].checked = false;
    }
  }
}
</script>

<div class="mg-manager-toolbar">
  <div class="mg-manager-select-actions">
    <button type="button" class="uk-button uk-button-small mg-button-quiet" onclick="doCheckAll_mediaitems()">{lang_checkall}</button>
    <button type="button" class="uk-button uk-button-small mg-button-quiet" onclick="doUnCheckAll_mediaitems()">{lang_uncheckall}</button>
  </div>

  <label class="mg-manager-default-cover" for="mg-reset-cover">
    <input type="radio" id="mg-reset-cover" name="cover" value="-2"{val_reset_cover}{xhtml}>
    <span>{lang_reset_cover}</span>
  </label>
</div>

<div class="mg-manager-grid">
  <!-- BEGIN ImageRow -->
  <!-- BEGIN ImageColumn -->
  <article class="mg-manager-card">
    <div class="mg-manager-card__top">
      <label class="mg-manager-select">
        <input type="checkbox" id="mg-media-select-{counter}" name="sel[]" value="{mid}" aria-label="{lang_select}"{xhtml}>
        <span>{lang_select}</span>
      </label>
      <input type="hidden" name="mid[]" value="{mid}"{xhtml}>
      <span class="mg-manager-watermark" title="{lang_watermarked}">{watermarked}</span>
    </div>

    <div class="mg-manager-card__body">
      <div class="mg-manager-preview">
        {media_zoom}<img src="{u_thumbnail}" height="{height}" width="{width}" alt="{media_title}" loading="lazy" decoding="async"{xhtml}></a>
        <a class="uk-button uk-button-small mg-manager-edit mg-button-quiet" href="{media_edit}">{lang_edit}</a>
      </div>

      <div class="mg-manager-controls">
        <label>
          <span>{lang_order}</span>
          <input type="number" id="mg-media-order-{counter}" name="seq[]" value="{order}" inputmode="numeric" aria-label="{lang_order}"{xhtml}>
          <input type="hidden" name="oldseq[]" value="{order}"{xhtml}>
        </label>

        <label class="mg-manager-choice">
          <span>{lang_cover}</span>
          {radio_box}
        </label>

        <label class="mg-manager-choice">
          <span>{lang_include_ss}</span>
          {include_ss}
        </label>
      </div>
    </div>

    <div class="mg-manager-fields">
      <label for="mg-media-title-{counter}">
        <span>{lang_title}</span>
        <input type="text" id="mg-media-title-{counter}" name="mtitle[]" value="{media_title}" class="mg-media-manager-input"{xhtml}>
      </label>

      <label for="mg-media-desc-{counter}">
        <span>{lang_description}</span>
        <textarea id="mg-media-desc-{counter}" name="mdesc[]" rows="3" class="mg-media-manager-textarea">{media_desc}</textarea>
      </label>

      <label for="mg-media-keywords-{counter}">
        <span>{lang_keywords}</span>
        <input type="text" id="mg-media-keywords-{counter}" name="mkeywords[]" value="{media_keywords}" class="mg-media-manager-input"{xhtml}>
      </label>

      <label for="mg-media-category-{counter}">
        <span>{lang_category}</span>
        {cat_select}
      </label>
    </div>
  </article>
  <!-- END ImageColumn -->
  <!-- END ImageRow -->
</div>

<div class="mg-manager-batch">
  <div class="mg-manager-batch__section">
    <label for="mg-media-destination-album">{lang_albumsel}</label>
    <div>{albumselect}</div>
    <input type="submit" name="mode" value="{lang_move}" class="uk-button"{xhtml}>
  </div>

  <div class="mg-manager-batch__section">
    <label for="mg-media-batch-option">{lang_batch_options}</label>
    <div>{batchoptionselect}</div>
    <input type="submit" name="mode" value="{lang_batch}" class="uk-button"{xhtml}>
  </div>
</div>
