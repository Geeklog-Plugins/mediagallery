<article class="mg_media_item mg-card mg-card-compact">
  <div class="mg-card-media">
    <div class="mg_thumbnail">
      <div class="mg_thumbnail_wrapper">{media_card_preview}{mp3_podcast}</div>
    </div>
  </div>

  <div class="mg-card-body">
    <h2 class="mg_title mg-card-title">
      {media_title}
      {!if musicalbum}
      <span class="mg-card-subtitle">/ {musicalbum}</span>
      {!endif}
    </h2>

    {!if artist}
    <div class="mg_artist mg-card-artist">{artist}</div>
    {!endif}

    {!if search_album}
    <div class="mg_search_album">{search_album}</div>
    {!endif}

    <div class="mg-card-meta mg-card-meta-compact">
      <span class="mg_time">{media_date_short}</span>
      {!if media_views}<span class="mg_views">{media_views_count} {lang_views}</span>{!endif}
      {!if media_comments}<span class="mg_comments">{media_comments_count} {lang_comments}</span>{!endif}
    </div>

    {!if edit_link}
    <div class="mgMediaEdit mg-card-edit">{edit_link}</div>
    {!endif}
  </div>
</article>
