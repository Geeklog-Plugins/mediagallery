<script type="text/javascript">
function InsertHtml(htmltag)
{
    if (!window.opener || window.opener.closed) {
        return false;
    }
    window.opener.postMessage({
        source: 'mediagallery',
        action: 'insert',
        target: {target_json},
        value: htmltag
    }, window.location.origin);
    return true;
}
</script>

<form class="mg-picker" name="mediabrowser" method="post" action="{s_form_action}">
<input type="hidden" name="i" value="{instance}">
<input type="hidden" name="target" value="{target_attr}">
<input type="hidden" name="refresh" value="1">
<input type="hidden" name="navigation" value="none">\n<input type="hidden" name="current_album_id" value="{album_id}">

<header class="mg-picker__header">
  <div>
    <h1 class="mg-picker__title">{lang_thumbnails}</h1>
    <p class="mg-picker__help">{picker_help}</p>
  </div>
  <button class="mg-picker__close" type="button" onclick="window.close();">{lang_cancel}</button>
</header>

<section class="mg-picker__album">
  <div class="mg-picker__album-nav">
    <div class="mg-picker__album-select">{jumpbox}</div>
    <div class="mg-picker__pagination">
      <button type="submit" aria-label="Previous page" onclick='document.mediabrowser.navigation.value="prev"'{prev_disabled}>&lsaquo;</button>
      <span>{page_number}</span>
      <button type="submit" aria-label="Next page" onclick='document.mediabrowser.navigation.value="next"'{next_disabled}>&rsaquo;</button>
    </div>
  </div>
  <div class="mg-picker__album-action">
    <button class="mg-picker__button mg-picker__button--secondary" type="button" onclick="return insertAlbum(this.form);">
      {insert_album}
    </button>
  </div>
</section>

<section class="mg-picker__media" aria-label="{lang_thumbnails}">
  {album_body}
</section>

<footer class="mg-picker__footer">
  <button class="mg-picker__button mg-picker__button--primary" type="button" onclick="return insertImage(this.form);">
    {insert_media}
  </button>
  <button class="mg-picker__button" type="button" onclick="window.close();">{lang_cancel}</button>
</footer>
</form>
